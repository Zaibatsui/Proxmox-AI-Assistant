# Copy to .env and fill in real values. Never commit the resulting .env.
#
# Generate the two secrets below with:
#   python -c "import secrets,string;a=string.ascii_letters+string.digits;print(''.join(secrets.choice(a) for _ in range(32)))"
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
#
# Keep MONGO_ROOT_PASSWORD alphanumeric, or percent-encode it in MONGO_URL --
# characters like @ : / ? # break the connection string.

# --- MongoDB ---
MONGO_ROOT_USERNAME=proxmox_ai_root
MONGO_ROOT_PASSWORD=changeme-generate-a-32-char-random-string
MONGO_DB_NAME=proxmox_ai_admin

# --- Backend ---
# Must match the credentials above. authSource=admin because the root user is
# created in the admin database.
MONGO_URL=mongodb://proxmox_ai_root:changeme-generate-a-32-char-random-string@mongodb:27017/?authSource=admin

# Signs all API session tokens. Anyone holding this can mint a token for any
# user and read every stored credential through the API. No default is provided
# on purpose -- the backend refuses to start without it.
JWT_SECRET=changeme-generate-a-64-char-random-string

# Comma-separated origins. Do not use '*' with credentialed requests.
CORS_ORIGINS=http://localhost:3000

OPENAI_API_KEY=

# --- Frontend ---
REACT_APP_BACKEND_URL=http://localhost:8001
